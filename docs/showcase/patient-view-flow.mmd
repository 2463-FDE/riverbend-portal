    classDef model fill:#bfdbfe,stroke:#1d4ed8,stroke-width:2px,color:#111
    classDef good fill:#bbf7d0,stroke:#15803d,stroke-width:2px,color:#111
    class AUTH gate
    class DENY stop
    class HUMAN human
    class SYN model
    class REL good
