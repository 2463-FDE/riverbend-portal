ENVIRONMENT=development

DB_HOST=postgres
DB_PORT=5432
DB_NAME=riverbend
DB_USER=riverbend_app
DB_PASSWORD=changeme

REDIS_URL=redis://redis:6379/0

PAYER_API_URL=https://edi.example.com/v1/eligibility
PAYER_API_KEY=changeme

HL7_FEED_HOST=hl7.example.org
HL7_FEED_PORT=2575

SESSION_SECRET=changeme

# --- AI orchestrator (W1) ----------------------------------------------------
# Stub by default: the stack runs and the whole test suite passes with NO AWS
# credential and zero spend.
USE_STUB_BEDROCK=true
AWS_REGION=us-east-1

# Bedrock credential. Prefer a SHORT-TERM API key (<=12h) or an IAM role — AWS
# documents long-term keys as "recommended only for exploration".
# https://docs.aws.amazon.com/bedrock/latest/userguide/api-keys.html
AWS_BEARER_TOKEN_BEDROCK=

# Region-scoped INFERENCE PROFILE id. A bare model id fails with a
# ValidationException at call time (i.e. in the demo, not in CI).
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0

# Compliance control, not a tunable: the effective Bedrock data-retention mode
# must be `none` for a PHI workload. A model whose allowed_modes excludes `none`
# shares prompts and completions with the model provider for up to 30 days.
# See adr/0004 §1a. Leave this true.
BEDROCK_REQUIRE_ZERO_RETENTION=true

# Cost + latency envelope
BEDROCK_DEADLINE_S=30
BEDROCK_MAX_INPUT_TOKENS=4000
BEDROCK_MAX_OUTPUT_TOKENS=600
BEDROCK_MAX_COST_PER_REQUEST_USD=0.05

# Tier-1 Bedrock Guardrails (off until a guardrail exists in the account)
BEDROCK_GUARDRAIL_ENABLED=false
BEDROCK_GUARDRAIL_ID=

# --- Knowledge base / RAG (W2) ------------------------------------------------
# memory | persistent | http.  `http` points at the compose Chroma service and is
# the production shape; the code path is identical either way (adr/0006).
CHROMA_MODE=http
CHROMA_HOST=chroma
CHROMA_PORT=8000

# offline | titan. `offline` is deterministic, free and needs no credential — it
# is what CI uses so the eval harness is reproducible.
RAG_EMBED_BACKEND=offline
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
RAG_EMBED_DIMS=256

RAG_RETRIEVAL_MODE=hybrid
RAG_RETRIEVE_K=4

# Quota discipline: W2 is a quota-risk week. Raise this deliberately, never by
# accident — an uncapped ingest over a full record dump is the failure the
# client packet warns about.
RAG_CORPUS_MAX_CHUNKS=500

# Knowledge-base ingest capability (interim control until the W9 RBAC split).
# A session may ingest if its username OR its role is on the respective list.
KNOWLEDGE_INGEST_USERS=
KNOWLEDGE_INGEST_ROLES=knowledge_admin

# --- Eligibility resilience (W3, adr/0008) ------------------------------------
# Derived, not guessed. See services/eligibility-service/config.py for the
# reasoning behind each number before changing one.
PAYER_CONNECT_TIMEOUT_S=2
PAYER_READ_TIMEOUT_S=4
PAYER_TOTAL_TIMEOUT_S=5
PAYER_BREAKER_THRESHOLD=5
PAYER_BREAKER_COOLDOWN_S=30
ELIGIBILITY_CACHE_TTL_S=86400

# --- Eligibility agent (W3) ---------------------------------------------------
# Durable agent memory holds PHI (staff free-text contains patient names), so the
# durable path uses an ENCRYPTED serializer. Requires LANGGRAPH_AES_KEY.
AGENT_DURABLE_MEMORY=false
AGENT_CHECKPOINT_PATH=/data/agent-checkpoints.db
# LANGGRAPH_AES_KEY=

# Third-party tracing uploads prompt BODIES. Staff free-text contains patient
# names and the regex scrub does not catch names, so this is an un-BAA'd
# disclosure path for the agent endpoint. Requires BOTH the flag and a key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
